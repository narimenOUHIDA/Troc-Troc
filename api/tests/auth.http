@token = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VyX2lkIjozLCJpYXQiOjE3OTQ0OTMxOTAsImV4cCI6MTc5NDU3OTU5MH0.8J_iNcX0xIzGEzPkx5qrBCP6v5tyMYHoZUEYX-qWshQ
@conversationId = 2

### POST register
POST http://localhost:3000/auth/register HTTP/1.1
Content-Type: application/json

{
    "firstName": "Marie",
    "lastName": "Curie",
    "email": "marie.test@example.com",
    "password": "Test12345",
    "postalCode": "69001"
}

### POST login
POST http://localhost:3000/auth/login HTTP/1.1
Content-Type: application/json
{
    "email": "narimen@oclock.com",
    "password": "1234"
}

### GET Me
GET http://localhost:3000/auth/me HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

### GET Categories
GET http://localhost:3000/api/v1/categories HTTP/1.1

### POST photos
POST http://localhost:3000/photos
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="uploaded_file"; filename="ton-image.jpg"
Content-Type: image/jpeg

< ./ton-image.jpg

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="listingId"

1
------WebKitFormBoundary7MA4YWxkTrZu0gW--

### GET My listings
GET http://localhost:3000/api/v1/annonces/mes-annonces HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

### Lire les messages sans token
GET {{baseUrl}}/api/v1/conversations/{{conversationId}}/messages HTTP/1.1

### Lire les messages d'une conversation dont je ne suis pas participant
GET {{baseUrl}}/api/v1/conversations/{{conversationId}}/messages HTTP/1.1
Authorization: Bearer {{token}}

### GET Mes conversations
GET http://localhost:3000/api/v1/conversations HTTP/1.1
Authorization: Bearer {{token}}

### POST Créer une conversation
POST http://localhost:3000/api/v1/conversations HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "listingId": 1
}

### Envoyer un message dans une conversation dont je suis participant
POST {{baseUrl}}/api/v1/conversations/{{conversationId}}/messages HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "content": "Bonjour, votre annonce est-elle toujours disponible ?"
}